{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "main.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/v1/runtime/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/v1/chronos/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
